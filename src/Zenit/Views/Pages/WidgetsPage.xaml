<UserControl x:Class="Zenit.Views.Pages.WidgetsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="clr-namespace:Zenit.Services"
             Width="430" Height="204">
  <Grid>
    <UniformGrid x:Name="Tiles" Rows="1" Margin="18,20,18,28" />
    <TextBlock x:Name="EmptyText" FontSize="13" Foreground="#A3FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"
               TextAlignment="Center" Visibility="Collapsed"
               Text="{s:Tr Es='Agrega widgets en Configuración → Widgets', En='Add widgets in Settings → Widgets'}" />
  </Grid>
</UserControl>
