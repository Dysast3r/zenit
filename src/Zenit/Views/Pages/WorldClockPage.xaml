             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="clr-namespace:Zenit.Services"
             Width="430" Height="204">
  <Grid>
    <UniformGrid x:Name="Clocks" Rows="1" Margin="14,20,14,26" />
    <TextBlock x:Name="EmptyText" FontSize="13" Foreground="#A3FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"
               Text="{s:Tr Es='Agrega ciudades en Configuración', En='Add cities in Settings'}" Visibility="Collapsed" />
  </Grid>
</UserControl>
