<UserControl x:Class="Zenit.Views.Pages.ClockPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="430" Height="204">
  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,12">
    <TextBlock HorizontalAlignment="Center" Foreground="{DynamicResource Ink}" Typography.NumeralAlignment="Tabular"
               FontFamily="Segoe UI Variable Display, Segoe UI">
      <Run x:Name="TimeRun" FontSize="58" FontWeight="Light" /><Run x:Name="SecondsRun" FontSize="24" FontWeight="Light" Foreground="{DynamicResource Ink80}" />
    </TextBlock>
    <TextBlock x:Name="DateText" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource InkE6}"
               HorizontalAlignment="Center" Margin="0,-6,0,0" />

    <!-- Avance del día -->
    <Grid Width="200" Height="3" Margin="0,12,0,0">
      <Border CornerRadius="1.5" Background="{DynamicResource Ink26}" />
      <Border x:Name="DayFill" CornerRadius="1.5" HorizontalAlignment="Left" Width="0">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1746D8" Offset="0" />
            <GradientStop Color="#0A84FF" Offset="0.6" />
            <GradientStop Color="#22D3EE" Offset="1" />
          </LinearGradientBrush>
        </Border.Background>
      </Border>
    </Grid>
    <TextBlock x:Name="DayInfoText" FontSize="11" Foreground="{DynamicResource Ink73}" HorizontalAlignment="Center" Margin="0,7,0,0" />
  </StackPanel>
</UserControl>
