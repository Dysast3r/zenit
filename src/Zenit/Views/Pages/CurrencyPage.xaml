<UserControl x:Class="Zenit.Views.Pages.CurrencyPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="430" Height="204">
  <Grid>
    <Grid Margin="24,18,24,0" VerticalAlignment="Top">
      <TextBlock x:Name="HeaderText" FontSize="13.5" FontWeight="SemiBold" Foreground="White" />
      <TextBlock x:Name="DateText" FontSize="11" Foreground="#73FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Center" />
    </Grid>
    <UniformGrid x:Name="Tiles" Rows="1" Margin="18,46,18,28" />
    <TextBlock x:Name="StatusText" FontSize="13" Foreground="#A3FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
  </Grid>
</UserControl>
