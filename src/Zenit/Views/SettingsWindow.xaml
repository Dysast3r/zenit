<Window x:Class="Zenit.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Zenit.Controls"
        xmlns:s="clr-namespace:Zenit.Services"
        ThemeMode="Dark"
        Title="{s:Tr Es='Configuración · Zenit', En='Settings · Zenit'}"
        Width="1000" Height="700" MinWidth="840" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/icon.ico"
        Background="#070C18"
        FontFamily="Segoe UI Variable Text, Segoe UI">

  <Window.Resources>
    <SolidColorBrush x:Key="CardBrush" Color="#0EFFFFFF" />
    <SolidColorBrush x:Key="CardBorder" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="Muted" Color="#9EFFFFFF" />
    <SolidColorBrush x:Key="Subtle" Color="#70FFFFFF" />
    <LinearGradientBrush x:Key="Brand" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#1746D8" Offset="0" />
      <GradientStop Color="#0A84FF" Offset="0.55" />
      <GradientStop Color="#22D3EE" Offset="1" />
    </LinearGradientBrush>

    <!-- Tarjeta de ajuste -->
    <Style TargetType="c:SettingCard">
      <Setter Property="Margin" Value="0,0,0,4" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="c:SettingCard">
            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                    CornerRadius="8" Padding="16,13" MinHeight="66">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{TemplateBinding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18"
                           VerticalAlignment="Center" Margin="2,0,18,0" Foreground="#E6FFFFFF" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                  <TextBlock Text="{TemplateBinding Header}" FontSize="14" Foreground="White" TextWrapping="Wrap" />
                  <TextBlock Text="{TemplateBinding Description}" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Style.Triggers>
                          <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </StackPanel>
                <ContentPresenter Grid.Column="2" VerticalAlignment="Center" />
              </Grid>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Interruptor estilo Windows 11 -->
    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <TextBlock x:Name="Label" Text="{s:Tr Es='Desactivado', En='Off'}" FontSize="13" Foreground="{StaticResource Muted}"
                         VerticalAlignment="Center" Margin="0,0,12,0" />
              <Grid Width="40" Height="20">
                <Border x:Name="Track" CornerRadius="10" BorderThickness="1" BorderBrush="#9EFFFFFF" Background="Transparent" />
                <Ellipse x:Name="Knob" Width="12" Height="12" Fill="#CCFFFFFF" HorizontalAlignment="Left" Margin="4,0,0,0">
                  <Ellipse.RenderTransform><TranslateTransform x:Name="KnobShift" /></Ellipse.RenderTransform>
                </Ellipse>
              </Grid>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="{StaticResource Brand}" />
                <Setter TargetName="Track" Property="BorderBrush" Value="Transparent" />
                <Setter TargetName="Knob" Property="Fill" Value="White" />
                <Setter TargetName="Label" Property="Text" Value="{s:Tr Es='Activado', En='On'}" />
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="KnobShift" Storyboard.TargetProperty="X" To="20" Duration="0:0:0.25">
                        <DoubleAnimation.EasingFunction><BackEase Amplitude="0.4" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="KnobShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.25">
                        <DoubleAnimation.EasingFunction><BackEase Amplitude="0.4" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Knob" Property="Width" Value="14" />
                <Setter TargetName="Knob" Property="Height" Value="14" />
                <Setter TargetName="Knob" Property="Margin" Value="3,0,0,0" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Tarjeta de elección de estilo (notch / flotante) -->
    <Style x:Key="StyleTile" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid>
              <Border x:Name="Frame" CornerRadius="10" BorderThickness="2" BorderBrush="{StaticResource CardBorder}"
                      Background="{StaticResource CardBrush}" Padding="6">
                <ContentPresenter />
              </Border>
              <!-- Borde de marca encima, que entra con un fundido y un leve rebote al elegir el estilo -->
              <Border x:Name="Selected" CornerRadius="10" BorderThickness="2" BorderBrush="{StaticResource Brand}"
                      Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform><ScaleTransform x:Name="SelectedScale" ScaleX="1.03" ScaleY="1.03" /></Border.RenderTransform>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Selected" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.22">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                      <DoubleAnimation Storyboard.TargetName="SelectedScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.35">
                        <DoubleAnimation.EasingFunction><BackEase Amplitude="0.5" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                      <DoubleAnimation Storyboard.TargetName="SelectedScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.35">
                        <DoubleAnimation.EasingFunction><BackEase Amplitude="0.5" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Selected" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                      <DoubleAnimation Storyboard.TargetName="SelectedScale" Storyboard.TargetProperty="ScaleX" To="1.03" Duration="0:0:0.18" />
                      <DoubleAnimation Storyboard.TargetName="SelectedScale" Storyboard.TargetProperty="ScaleY" To="1.03" Duration="0:0:0.18" />
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Frame" Property="Background" Value="#18FFFFFF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="NavItem" TargetType="ListBoxItem">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Grid Margin="0,1">
              <Border x:Name="Bg" CornerRadius="6" Background="Transparent" />
              <Border x:Name="Pill" Width="3" Height="16" CornerRadius="1.5" Background="{StaticResource Brand}"
                      HorizontalAlignment="Left" Opacity="0" />
              <ContentPresenter Margin="14,9" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="#0FFFFFFF" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="#14FFFFFF" />
                <Setter TargetName="Pill" Property="Opacity" Value="1" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Margin" Value="2,22,0,8" />
    </Style>

    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="4,0,0,0" />
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="268" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Navegación -->
    <DockPanel Margin="16,18,8,16">
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,22">
        <Image Source="pack://application:,,,/Assets/logo.png" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality" />
        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="Zenit" FontSize="17" FontWeight="SemiBold" Foreground="White" />
          <TextBlock x:Name="VersionText" FontSize="12" Foreground="{StaticResource Muted}" />
        </StackPanel>
      </StackPanel>
      <ListBox x:Name="Nav" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource NavItem}"
               SelectionChanged="Nav_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
    </DockPanel>

    <!-- Contenido -->
    <ScrollViewer x:Name="Scroller" Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="8,18,32,32">
      <StackPanel MaxWidth="880">
        <TextBlock x:Name="PageTitle" FontSize="28" FontWeight="SemiBold" Foreground="White" FontFamily="Segoe UI Variable Display, Segoe UI" />
        <TextBlock x:Name="PageSubtitle" FontSize="13" Foreground="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap" />

        <!-- ═════════════ General ═════════════ -->
        <StackPanel x:Name="GeneralSection" Margin="0,18,0,0">
          <!-- Portada con vista previa -->
          <Border CornerRadius="14" Height="150" Background="{StaticResource Brand}" ClipToBounds="True">
            <Grid>
              <Ellipse Width="320" Height="320" Fill="#22FFFFFF" HorizontalAlignment="Right" Margin="0,-170,-90,0" />
              <Ellipse Width="200" Height="200" Fill="#14FFFFFF" HorizontalAlignment="Left" Margin="-60,40,0,-120" />
              <Path x:Name="HeroNotch" Fill="Black" HorizontalAlignment="Center" VerticalAlignment="Top" />
              <StackPanel x:Name="HeroNotchContent" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0">
                <TextBlock x:Name="HeroTime" FontSize="13" FontWeight="SemiBold" Foreground="White" />
                <Ellipse Width="3" Height="3" Fill="#66FFFFFF" Margin="8,0" VerticalAlignment="Center" />
                <c:WeatherGlyph Width="16" Height="16" Kind="PartlyCloudy" />
                <TextBlock Text=" 21°" FontSize="13" FontWeight="SemiBold" Foreground="White" />
              </StackPanel>
              <StackPanel VerticalAlignment="Bottom" Margin="24,0,24,20">
                <TextBlock Text="{s:Tr Es='Tu isla, a tu manera', En='Your island, your way'}" FontSize="24" FontWeight="SemiBold"
                           Foreground="White" FontFamily="Segoe UI Variable Display, Segoe UI" />
                <TextBlock Text="{s:Tr Es='Cada cambio se aplica al instante en la isla.', En='Every change applies to the island instantly.'}"
                           FontSize="13" Foreground="#E6FFFFFF" />
              </StackPanel>
            </Grid>
          </Border>

          <TextBlock Style="{StaticResource SectionTitle}" Text="{s:Tr Es='Idioma', En='Language'}" />
          <c:SettingCard Glyph="&#xF2B7;" Header="{s:Tr Es='Idioma de la app', En='App language'}"
                         Description="{s:Tr Es='Automático usa el idioma de Windows. Al cambiarlo, la app se reinicia en un segundo.', En='Automatic follows Windows. Changing it restarts the app in a second.'}">
            <ComboBox x:Name="LanguageCombo" Width="230" SelectionChanged="Language_Changed" />
          </c:SettingCard>

          <TextBlock Style="{StaticResource SectionTitle}" Text="{s:Tr Es='Apariencia', En='Appearance'}" />
          <UniformGrid Columns="2" Margin="0,0,0,4">
            <RadioButton x:Name="StyleNotch" GroupName="IslandStyle" Style="{StaticResource StyleTile}" Margin="0,0,4,0" Checked="Style_Checked">
              <StackPanel>
                <Border Height="92" CornerRadius="6" Background="#FF12203A" ClipToBounds="True">
                  <Path Fill="Black" HorizontalAlignment="Center" VerticalAlignment="Top"
                        Data="M 0,0 L 140,0 A 6,6 0 0 0 134,6 L 134,20 A 14,14 0 0 1 120,34 L 20,34 A 14,14 0 0 1 6,20 L 6,6 A 6,6 0 0 0 0,0 Z" />
                </Border>
                <TextBlock Text="{s:Tr Es='Notch clásico', En='Classic notch'}" FontSize="13.5" FontWeight="SemiBold" Foreground="White" Margin="6,10,0,0" />
                <TextBlock Text="{s:Tr Es='Pegado al borde, con curvas que se funden con la pantalla', En='Attached to the edge, with curves that blend into the screen'}"
                           FontSize="12" Foreground="{StaticResource Muted}" Margin="6,2,0,6" TextWrapping="Wrap" />
              </StackPanel>
            </RadioButton>
            <RadioButton x:Name="StyleFloating" GroupName="IslandStyle" Style="{StaticResource StyleTile}" Margin="4,0,0,0" Checked="Style_Checked">
              <StackPanel>
                <Border Height="92" CornerRadius="6" Background="#FF12203A">
                  <Border Width="124" Height="30" CornerRadius="15" Background="Black" VerticalAlignment="Top" Margin="0,8,0,0" />
                </Border>
                <TextBlock Text="{s:Tr Es='Isla flotante', En='Floating island'}" FontSize="13.5" FontWeight="SemiBold" Foreground="White" Margin="6,10,0,0" />
                <TextBlock Text="{s:Tr Es='Una píldora separada del borde superior', En='A pill floating below the top edge'}"
                           FontSize="12" Foreground="{StaticResource Muted}" Margin="6,2,0,6" TextWrapping="Wrap" />
              </StackPanel>
            </RadioButton>
          </UniformGrid>

          <c:SettingCard Glyph="&#xE793;" Header="{s:Tr Es='Tema de la isla', En='Island theme'}"
                         Description="{s:Tr Es='Oscuro, claro o el modo de las aplicaciones de Windows. Al cambiarlo, la app se reinicia en un segundo.', En='Dark, light or the Windows app mode. Changing it restarts the app in a second.'}">
            <ComboBox x:Name="ThemeCombo" Width="230" SelectionChanged="Theme_Changed" />
          </c:SettingCard>

          <c:SettingCard Glyph="&#xE7F4;" Header="{s:Tr Es='Contenido en reposo', En='Idle content'}"
                         Description="{s:Tr Es='Qué muestra la isla cuando no suena música', En='What the island shows when no music is playing'}">
            <ComboBox x:Name="IdleCombo" Width="230" SelectionChanged="Any_Changed" />
          </c:SettingCard>
          <!-- Tamaño de la isla: tarjeta dedicada con atajos y ajuste fino -->
          <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                  CornerRadius="8" Padding="16,14" Margin="0,4,0,4">
            <StackPanel>
              <Grid>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE740;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18"
                             VerticalAlignment="Center" Margin="2,0,18,0" Foreground="#E6FFFFFF" />
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{s:Tr Es='Tamaño de la isla', En='Island size'}" FontSize="14" Foreground="White" />
                    <TextBlock Text="{s:Tr Es='Hazla más pequeña o más grande; el cambio se ve al instante', En='Make it smaller or bigger; the change is instant'}"
                               FontSize="12" Foreground="{StaticResource Muted}" Margin="0,2,0,0" />
                  </StackPanel>
                </StackPanel>
                <TextBlock x:Name="ScaleLabel" FontSize="20" FontWeight="SemiBold" Foreground="White"
                           HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Segoe UI Variable Display, Segoe UI" />
              </Grid>

              <UniformGrid x:Name="SizePresets" Rows="1" Margin="38,14,0,0" />

              <Grid Margin="38,12,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="34" Height="8" CornerRadius="4" Background="White" VerticalAlignment="Center" />
                <Slider x:Name="ScaleSlider" Grid.Column="1" Margin="14,0" Minimum="0.6" Maximum="1.6" TickFrequency="0.05"
                        IsSnapToTickEnabled="True" ValueChanged="Slider_Changed" VerticalAlignment="Center" />
                <Border Grid.Column="2" Width="64" Height="16" CornerRadius="8" Background="White" VerticalAlignment="Center" />
              </Grid>
            </StackPanel>
          </Border>
          <c:SettingCard Glyph="&#xE76F;" Header="{s:Tr Es='Distancia desde arriba', En='Distance from top'}">
            <StackPanel Orientation="Horizontal">
              <Slider x:Name="OffsetSlider" Width="200" Minimum="0" Maximum="80" TickFrequency="2" IsSnapToTickEnabled="True" ValueChanged="Slider_Changed" VerticalAlignment="Center" />
              <TextBlock x:Name="OffsetLabel" Width="48" TextAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource Muted}" />
            </StackPanel>
          </c:SettingCard>
          <c:SettingCard Glyph="&#xE7C2;" Header="{s:Tr Es='Posición en el borde', En='Position along the edge'}"
                         Description="{s:Tr Es='Mantén el clic derecho sobre la isla y arrástrala para moverla', En='Hold the right mouse button on the island and drag it to move it'}">
            <Button x:Name="CenterIslandButton" Content="{s:Tr Es='Centrar', En='Center'}" Padding="18,6" Click="CenterIsland_Click" />
          </c:SettingCard>
          <c:SettingCard Glyph="&#xE790;" Header="{s:Tr Es='Color de acento', En='Accent color'}"
                         Description="{s:Tr Es='Ecualizador y resplandor. Automático toma el color de la carátula', En='Equalizer and glow. Automatic uses the album art color'}">
            <StackPanel Orientation="Horizontal">
              <ComboBox x:Name="AccentCombo" Width="150" SelectionChanged="Any_Changed" />
              <StackPanel x:Name="Swatches" Orientation="Horizontal" Margin="10,0,0,0" />
            </StackPanel>
          </c:SettingCard>
          <c:SettingCard Glyph="&#xE706;" Header="{s:Tr Es='Borde neón', En='Neon edge'}"
                         Description="{s:Tr Es='Resplandor del color de acento alrededor de la isla', En='Accent-colored glow around the island'}">
            <CheckBox x:Name="GlowSwitch" Style="{StaticResource Switch}" Click="Any_Changed" />
          </c:SettingCard>
          <StackPanel x:Name="GlowOptions">
            <c:SettingCard Glyph="&#xE790;" Header="{s:Tr Es='Tono del neón', En='Neon tone'}"
                           Description="{s:Tr Es='El color de acento, uno a tu gusto o un degradado de dos', En='The accent color, one of your choice or a two-color gradient'}">
              <ComboBox x:Name="GlowToneCombo" Width="230" SelectionChanged="Any_Changed" />
            </c:SettingCard>
            <c:SettingCard x:Name="GlowColorsCard" Glyph="&#xE771;" Header="{s:Tr Es='Colores del neón', En='Neon colors'}"
                           Description="{s:Tr Es='La segunda fila es el otro extremo del degradado', En='The second row is the other end of the gradient'}">
              <StackPanel>
                <StackPanel x:Name="GlowSwatches" Orientation="Horizontal" />
                <StackPanel x:Name="GlowSwatches2" Orientation="Horizontal" Margin="0,8,0,0" />
              </StackPanel>
            </c:SettingCard>
            <c:SettingCard Glyph="&#xE768;" Header="{s:Tr Es='Animación del neón', En='Neon animation'}"
                           Description="{s:Tr Es='Pulso, giro alrededor del borde o arcoíris', En='Pulse, spin around the edge or rainbow'}">
              <ComboBox x:Name="GlowAnimationCombo" Width="230" SelectionChanged="Any_Changed" />
            </c:SettingCard>
          </StackPanel>

          <c:SettingCard Glyph="&#xE7F4;" Header="{s:Tr Es='Pantalla', En='Display'}"
                         Description="{s:Tr Es='En qué monitor aparece la isla, o en todos a la vez', En='Which monitor shows the island, or all of them at once'}">
            <ComboBox x:Name="MonitorCombo" Width="260" SelectionChanged="Any_Changed" />
          </c:SettingCard>

          <TextBlock Style="{StaticResource SectionTitle}" Text="{s:Tr Es='Comportamiento', En='Behavior'}" />
          <c:SettingCard Glyph="&#xE8B0;" Header="{s:Tr Es='Expandir al pasar el cursor', En='Expand on hover'}"
                         Description="{s:Tr Es='Si se desactiva, se abre con un clic', En='When off, click to open'}">
            <CheckBox x:Name="HoverSwitch" Style="{StaticResource Switch}" Click="Any_Changed" />
          </c:SettingCard>
          <c:SettingCard Glyph="&#xED1A;" Header="{s:Tr Es='Ocultar cuando no hay música', En='Hide when nothing is playing'}">
            <CheckBox x:Name="HideIdleSwitch" Style="{StaticResource Switch}" Click="Any_Changed" />
          </c:SettingCard>
          <c:SettingCard Glyph="&#xE740;" Header="{s:Tr Es='Ocultar en pantalla completa', En='Hide in full screen'}"
                         Description="{s:Tr Es='Juegos, películas y presentaciones', En='Games, movies and presentations'}">
            <CheckBox x:Name="FullscreenSwitch" Style="{StaticResource Switch}" Click="Any_Changed" />
          </c:SettingCard>
          <c:SettingCard Glyph="&#xE722;" Header="{s:Tr Es='Ocultar en capturas de pantalla', En='Hide from screenshots'}"
                         Description="{s:Tr Es='Tú la ves, pero no aparece en capturas, grabaciones ni al compartir pantalla', En='You see it, but it never shows in screenshots, recordings or screen sharing'}">
            <CheckBox x:Name="CaptureSwitch" Style="{StaticResource Switch}" Click="Any_Changed" />
          </c:SettingCard>
          <c:SettingCard Glyph="&#xE7E8;" Header="{s:Tr Es='Iniciar con Windows', En='Start with Windows'}">
            <CheckBox x:Name="StartupSwitch" Style="{StaticResource Switch}" Click="Any_Changed" />
          </c:SettingCard>
        </StackPanel>

        <!-- ═════════════ Páginas ═════════════ -->
        <StackPanel x:Name="PagesSection" Margin="0,18,0,0">
          <StackPanel x:Name="PagesList" />
          <Border CornerRadius="8" Background="{StaticResource CardBrush}" Padding="16,12" Margin="0,12,0,0">
            <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource Muted}"
                       Text="{s:Tr Es='Consejo: en la isla expandida, arrastra hacia los lados o usa el desplazamiento horizontal del touchpad para cambiar de página.', En='Tip: on the expanded island, drag sideways or use horizontal touchpad scrolling to switch pages.'}" />
          </Border>
        </StackPanel>

        <!-- ═════════════ Música ═════════════ -->
        <StackPanel x:Name="MusicSection" Margin="0,18,0,0">
          <c:SettingCard Glyph="&#xE8D6;" Header="{s:Tr Es='Solo apps de música', En='Music apps only'}"
                         Description="{s:Tr Es='Spotify, TIDAL y la app de YouTube Music. Si se desactiva, también muestra el navegador y otros reproductores (las apps de música tienen prioridad)', En='Spotify, TIDAL and the YouTube Music app. When off, also shows browsers and other players (music apps come first)'}">
            <CheckBox x:Name="MusicAppsOnlySwitch" Style="{StaticResource Switch}" Click="Any_Changed" />
          </c:SettingCard>
          <c:SettingCard Glyph="&#xE7E7;" Header="{s:Tr Es='Aviso al cambiar de canción', En='Notify on track change'}"
                         Description="{s:Tr Es='La isla se agranda un momento con el título y el artista', En='The island briefly grows to show title and artist'}">
            <CheckBox x:Name="PeekSwitch" Style="{StaticResource Switch}" Click="Any_Changed" />
          </c:SettingCard>
          <c:SettingCard Glyph="&#xE916;" Header="{s:Tr Es='Duración del aviso', En='Notification duration'}">
            <StackPanel Orientation="Horizontal">
              <Slider x:Name="PeekSlider" Width="200" Minimum="1" Maximum="10" TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="Slider_Changed" VerticalAlignment="Center" />
              <TextBlock x:Name="PeekLabel" Width="48" TextAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource Muted}" />
            </StackPanel>
          </c:SettingCard>
          <c:SettingCard Glyph="&#xE9E9;" Header="{s:Tr Es='Ecualizador reactivo', En='Reactive equalizer'}"
                         Description="{s:Tr Es='Las barras siguen el volumen real del audio (solo lee el nivel, nunca graba)', En='Bars follow the real audio level (only reads the level, never records)'}">
            <CheckBox x:Name="ReactiveSwitch" Style="{StaticResource Switch}" Click="Any_Changed" />
          </c:SettingCard>
          <c:SettingCard Glyph="&#xE8A1;" Header="{s:Tr Es='Centro de la isla compacta', En='Middle of the compact island'}"
                         Description="{s:Tr Es='Entre la carátula y el ecualizador. La canción se desplaza si no cabe', En='Between the artwork and the equalizer. The song scrolls if it does not fit'}">
            <ComboBox x:Name="CompactCenterCombo" Width="230" SelectionChanged="Any_Changed" />
          </c:SettingCard>
          <TextBlock Style="{StaticResource SectionTitle}" Text="{s:Tr Es='Gestos', En='Gestures'}" />
          <Border CornerRadius="8" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Padding="18,14">
            <StackPanel>
              <TextBlock Foreground="White" FontSize="13" Margin="0,0,0,6" Text="{s:Tr Es='• Clic o pasar el cursor: expandir', En='• Click or hover: expand'}" />
              <TextBlock Foreground="White" FontSize="13" Margin="0,0,0,6" Text="{s:Tr Es='• Deslizar la isla compacta a la izquierda / derecha: siguiente / anterior canción', En='• Swipe the compact island left / right: next / previous track'}" />
              <TextBlock Foreground="White" FontSize="13" Margin="0,0,0,6" Text="{s:Tr Es='• Arrastrar la barra de progreso: adelantar o retroceder', En='• Drag the progress bar: seek'}" />
              <TextBlock Foreground="White" FontSize="13" Margin="0,0,0,6" Text="{s:Tr Es='• Clic en la carátula: abrir la app de música', En='• Click the album art: open the music app'}" />
              <TextBlock Foreground="White" FontSize="13" Text="{s:Tr Es='• Clic derecho en la isla: menú rápido', En='• Right-click the island: quick menu'}" />
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- ═════════════ Reloj y fecha ═════════════ -->
        <StackPanel x:Name="ClockSection" Margin="0,18,0,0">
          <Border CornerRadius="12" Background="Black" Padding="20,18" Margin="0,0,0,8">
            <StackPanel HorizontalAlignment="Center">
              <TextBlock x:Name="ClockPreviewTime" FontSize="44" FontWeight="Light" Foreground="White" HorizontalAlignment="Center"
                         FontFamily="Segoe UI Variable Display, Segoe UI" Typography.NumeralAlignment="Tabular" />
              <TextBlock x:Name="ClockPreviewDate" FontSize="14" FontWeight="SemiBold" Foreground="#E6FFFFFF" HorizontalAlignment="Center" />
            </StackPanel>
          </Border>
          <c:SettingCard Glyph="&#xE823;" Header="{s:Tr Es='Formato de 24 horas', En='24-hour clock'}">
            <CheckBox x:Name="H24Switch" Style="{StaticResource Switch}" Click="Any_Changed" />
          </c:SettingCard>
          <c:SettingCard Glyph="&#xE916;" Header="{s:Tr Es='Mostrar segundos', En='Show seconds'}">
            <CheckBox x:Name="SecondsSwitch" Style="{StaticResource Switch}" Click="Any_Changed" />
          </c:SettingCard>
          <c:SettingCard Glyph="&#xE787;" Header="{s:Tr Es='Formato de fecha', En='Date format'}">
            <ComboBox x:Name="DateCombo" Width="320" SelectionChanged="Any_Changed" />
          </c:SettingCard>
          <c:SettingCard x:Name="CustomDateCard" Glyph="&#xE70F;" Header="{s:Tr Es='Formato personalizado', En='Custom format'}"
                         Description="{s:Tr Es='dddd = día · d = número · MMMM = mes · yyyy = año · texto entre comillas simples', En='dddd = weekday · d = day · MMMM = month · yyyy = year · literal text in single quotes'}">
            <TextBox x:Name="CustomDateBox" Width="240" TextChanged="CustomDate_Changed" />
          </c:SettingCard>
          <c:SettingCard Glyph="&#xE8BF;" Header="{s:Tr Es='Semana y día del año', En='Week and day of year'}"
                         Description="{s:Tr Es='Muestra, por ejemplo: Semana 44 · Día 300 de 365', En='Shows, e.g.: Week 44 · Day 300 of 365'}">
            <CheckBox x:Name="WeekSwitch" Style="{StaticResource Switch}" Click="Any_Changed" />
          </c:SettingCard>
        </StackPanel>

        <!-- ═════════════ Calendario ═════════════ -->
        <StackPanel x:Name="CalendarSection" Margin="0,18,0,0">
          <c:SettingCard Glyph="&#xE787;" Header="{s:Tr Es='Reuniones en la isla', En='Meetings on the island'}"
                         Description="{s:Tr Es='Antes de cada reunión la isla avisa y muestra la cuenta regresiva', En='Before each meeting the island alerts you and shows a countdown'}">
            <CheckBox x:Name="CalendarSwitch" Style="{StaticResource Switch}" Click="Any_Changed" />
          </c:SettingCard>
          <c:SettingCard Glyph="&#xE916;" Header="{s:Tr Es='Avisar con', En='Alert me'}">
            <ComboBox x:Name="CalendarLeadCombo" Width="200" SelectionChanged="Any_Changed" />
          </c:SettingCard>

          <TextBlock Style="{StaticResource SectionTitle}" Text="{s:Tr Es='Calendarios', En='Calendars'}" />
          <StackPanel x:Name="CalendarList" />
          <Border CornerRadius="8" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Padding="16,14" Margin="0,4,0,0">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid>
                  <TextBox x:Name="CalendarUrlBox" TextChanged="CalendarUrl_Changed" />
                  <TextBlock x:Name="CalendarUrlHint" Text="{s:Tr Es='Pega la dirección secreta en formato iCal (https://… .ics)', En='Paste the secret address in iCal format (https://… .ics)'}"
                             Foreground="{StaticResource Subtle}" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False" />
                </Grid>
                <Button Grid.Column="1" Content="{s:Tr Es='Agregar', En='Add'}" Margin="8,0,0,0" Padding="18,6" Click="AddCalendar_Click" />
              </Grid>
              <TextBlock x:Name="CalendarStatus" FontSize="12" Foreground="{StaticResource Muted}" Margin="2,8,0,0" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Border CornerRadius="8" Background="{StaticResource CardBrush}" Padding="16,12" Margin="0,12,0,0">
            <StackPanel>
              <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,4"
                         Text="{s:Tr Es='¿Dónde encuentro el enlace?', En='Where do I find the link?'}" />
              <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource Muted}"
                         Text="{s:Tr Es='Google Calendar: Configuración → tu calendario → Integrar el calendario → Dirección secreta en formato iCal. Outlook: Configuración → Calendario → Calendarios compartidos → Publicar un calendario → enlace ICS. Zenit solo lee el enlace; no pide tu cuenta ni tu contraseña.', En='Google Calendar: Settings → your calendar → Integrate calendar → Secret address in iCal format. Outlook: Settings → Calendar → Shared calendars → Publish a calendar → ICS link. Zenit only reads the link; it never asks for your account or password.'}" />
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- ═════════════ Relojes mundiales ═════════════ -->
        <StackPanel x:Name="WorldSection" Margin="0,18,0,0">
          <StackPanel x:Name="WorldList" />
          <TextBlock Style="{StaticResource SectionTitle}" Text="{s:Tr Es='Agregar ciudad (máximo 4)', En='Add a city (up to 4)'}" />
          <Border CornerRadius="8" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Padding="16,14">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ComboBox x:Name="ZoneCombo" IsEditable="True" IsTextSearchEnabled="True" TextSearch.TextPath="DisplayName"
                        DisplayMemberPath="DisplayName" SelectionChanged="ZoneCombo_SelectionChanged" />
              <TextBox x:Name="ZoneLabelBox" Grid.Column="1" Margin="8,0,0,0" />
              <Button Grid.Column="2" Content="{s:Tr Es='Agregar', En='Add'}" Margin="8,0,0,0" Padding="18,6" Click="AddZone_Click" />
            </Grid>
          </Border>
        </StackPanel>

        <!-- ═════════════ Clima ═════════════ -->
        <StackPanel x:Name="WeatherSection" Margin="0,18,0,0">
          <c:SettingCard Glyph="&#xE81D;" Header="{s:Tr Es='Usar mi ubicación actual', En='Use my current location'}"
                         Description="{s:Tr Es='Usa la ubicación de Windows si la permites; si no, una aproximación por tu IP', En='Uses Windows location if allowed; otherwise an approximation from your IP'}">
            <CheckBox x:Name="LocationSwitch" Style="{StaticResource Switch}" Click="Any_Changed" />
          </c:SettingCard>
          <c:SettingCard Glyph="&#xE9CA;" Header="{s:Tr Es='Unidad de temperatura', En='Temperature unit'}">
            <ComboBox x:Name="UnitCombo" Width="200" SelectionChanged="Any_Changed" />
          </c:SettingCard>
          <c:SettingCard Glyph="&#xE895;" Header="{s:Tr Es='Actualizar cada', En='Refresh every'}">
            <ComboBox x:Name="WeatherRefreshCombo" Width="200" SelectionChanged="Any_Changed" />
          </c:SettingCard>

          <TextBlock Style="{StaticResource SectionTitle}" Text="{s:Tr Es='Ciudades', En='Cities'}" />
          <StackPanel x:Name="CitiesList" />
          <Border CornerRadius="8" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Padding="16,14" Margin="0,4,0,0">
            <StackPanel>
              <Grid>
                <TextBox x:Name="CitySearchBox" TextChanged="CitySearch_Changed" Padding="34,6,10,6" />
                <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{StaticResource Muted}"
                           VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False" />
                <TextBlock x:Name="CitySearchHint" Text="{s:Tr Es='Buscar ciudad en cualquier parte del mundo…', En='Search any city in the world…'}"
                           Foreground="{StaticResource Subtle}" VerticalAlignment="Center" Margin="36,0,0,0" IsHitTestVisible="False" />
              </Grid>
              <StackPanel x:Name="CityResults" Margin="0,6,0,0" />
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- ═════════════ Monedas ═════════════ -->
        <StackPanel x:Name="CurrencySection" Margin="0,18,0,0">
          <c:SettingCard Glyph="&#xE80F;" Header="{s:Tr Es='Moneda local', En='Local currency'}"
                         Description="{s:Tr Es='Los valores se muestran en esta moneda', En='Values are shown in this currency'}">
            <ComboBox x:Name="LocalCurrencyCombo" Width="300" IsEditable="True" IsTextSearchEnabled="True" SelectionChanged="Any_Changed" />
          </c:SettingCard>
          <c:SettingCard Glyph="&#xE895;" Header="{s:Tr Es='Actualizar cada', En='Refresh every'}">
            <ComboBox x:Name="CurrencyRefreshCombo" Width="200" SelectionChanged="Any_Changed" />
          </c:SettingCard>

          <TextBlock Style="{StaticResource SectionTitle}" Text="{s:Tr Es='Indicadores a mostrar (máximo 8)', En='Indicators to show (up to 8)'}" />
          <UniformGrid x:Name="IndicatorList" Columns="2" Margin="0,0,-6,0" />

          <TextBlock Style="{StaticResource SectionTitle}" Text="{s:Tr Es='Otra moneda o criptomoneda', En='Another currency or cryptocurrency'}" />
          <Border CornerRadius="8" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Padding="16,14">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ComboBox x:Name="AddCurrencyCombo" IsEditable="True" IsTextSearchEnabled="True" />
              <Button Grid.Column="1" Content="{s:Tr Es='Agregar', En='Add'}" Margin="8,0,0,0" Padding="18,6" Click="AddCurrency_Click" />
            </Grid>
          </Border>
          <TextBlock FontSize="12" Foreground="{StaticResource Subtle}" Margin="2,10,0,0" TextWrapping="Wrap"
                     Text="{s:Tr Es='Más de 300 monedas y criptomonedas. Tipos de cambio diarios con la variación frente al día anterior. La UF y la UTM vienen de findic.cl o mindicador.cl, con la variación frente al valor anterior.', En='Over 300 currencies and cryptocurrencies. Daily rates with the change versus the previous day. UF and UTM come from findic.cl or mindicador.cl, with the change versus the previous value.'}" />
        </StackPanel>

        <!-- ═════════════ Sistema ═════════════ -->
        <StackPanel x:Name="SystemSection" Margin="0,18,0,0">
          <TextBlock Style="{StaticResource SectionTitle}" Margin="2,0,0,8" Text="{s:Tr Es='Avisos en la isla', En='Island alerts'}" />
          <c:SettingCard Glyph="&#xEA8F;" Header="{s:Tr Es='Notificaciones de Windows', En='Windows notifications'}"
                         Description="{s:Tr Es='WhatsApp, correo, Teams y más aparecen en la isla', En='WhatsApp, mail, Teams and more show up on the island'}">
            <CheckBox x:Name="NotificationsSwitch" Style="{StaticResource Switch}" Click="Any_Changed" />
          </c:SettingCard>
          <Border x:Name="NotificationsInfo" CornerRadius="8" Background="#1AF59E0B" BorderBrush="#40F59E0B" BorderThickness="1"
                  Padding="16,10" Margin="0,0,0,4" Visibility="Collapsed">
            <TextBlock x:Name="NotificationsInfoText" TextWrapping="Wrap" FontSize="12.5" Foreground="#FDE68A" />
          </Border>
          <c:SettingCard Glyph="&#xE767;" Header="{s:Tr Es='Indicador de volumen', En='Volume indicator'}"
                         Description="{s:Tr Es='La isla muestra el nivel cuando cambias el volumen', En='The island shows the level when the volume changes'}">
            <CheckBox x:Name="VolumeHudSwitch" Style="{StaticResource Switch}" Click="Any_Changed" />
          </c:SettingCard>
          <c:SettingCard Glyph="&#xE962;" Header="{s:Tr Es='Rueda del mouse sobre la isla', En='Mouse wheel over the island'}"
                         Description="{s:Tr Es='Sube o baja el volumen del sistema', En='Raises or lowers the system volume'}">
            <CheckBox x:Name="WheelVolumeSwitch" Style="{StaticResource Switch}" Click="Any_Changed" />
          </c:SettingCard>
          <c:SettingCard Glyph="&#xEBB5;" Header="{s:Tr Es='Batería', En='Battery'}"
                         Description="{s:Tr Es='Aviso al conectar el cargador y con batería baja', En='Alert when plugging in and on low battery'}">
            <CheckBox x:Name="BatterySwitch" Style="{StaticResource Switch}" Click="Any_Changed" />
          </c:SettingCard>
          <c:SettingCard Glyph="&#xE720;" Header="{s:Tr Es='Cámara y micrófono en uso', En='Camera and microphone in use'}"
                         Description="{s:Tr Es='Un punto verde cuando la cámara está en uso y uno naranja con el micrófono', En='A green dot while the camera is in use and an orange one for the microphone'}">
            <CheckBox x:Name="PrivacySwitch" Style="{StaticResource Switch}" Click="Any_Changed" />
          </c:SettingCard>
          <c:SettingCard Glyph="&#xE916;" Header="{s:Tr Es='Temporizador en vivo', En='Live timer'}"
                         Description="{s:Tr Es='La cuenta regresiva queda visible en la isla compacta', En='The countdown stays visible on the compact island'}">
            <CheckBox x:Name="TimerLiveSwitch" Style="{StaticResource Switch}" Click="Any_Changed" />
          </c:SettingCard>
          <c:SettingCard Glyph="&#xE708;" Header="{s:Tr Es='Respetar No molestar', En='Respect Do not disturb'}"
                         Description="{s:Tr Es='Con No molestar o una sesión de concentración, la isla calla notificaciones, canciones y reuniones. El volumen, el temporizador y la batería baja siguen avisando', En='With Do not disturb or a focus session, the island silences notifications, songs and meetings. Volume, timer and low battery still show'}">
            <CheckBox x:Name="DndSwitch" Style="{StaticResource Switch}" Click="Any_Changed" />
          </c:SettingCard>
        </StackPanel>

        <!-- ═════════════ Widgets ═════════════ -->
        <StackPanel x:Name="WidgetsSection" Margin="0,18,0,0">
          <Border CornerRadius="12" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Padding="18,16">
            <StackPanel>
              <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="White"
                         Text="{s:Tr Es='Un widget es un archivo JSON que muestra datos de cualquier API pública: precios, estadísticas, indicadores… No ejecuta código, así que es seguro compartirlos.', En='A widget is a JSON file that shows data from any public API: prices, stats, indicators… It never runs code, so widgets are safe to share.'}" />
              <WrapPanel Margin="0,12,0,0">
                <Button Content="{s:Tr Es='Abrir carpeta', En='Open folder'}" Padding="14,6" Margin="0,0,8,0" Click="OpenWidgets_Click" />
                <Button Content="{s:Tr Es='Recargar', En='Reload'}" Padding="14,6" Margin="0,0,8,0" Click="ReloadWidgets_Click" />
                <Button Content="{s:Tr Es='Instalar ejemplos', En='Install examples'}" Padding="14,6" Margin="0,0,8,0" Click="ExampleWidgets_Click" />
                <Button Content="{s:Tr Es='Cómo crear uno', En='How to make one'}" Padding="14,6" Click="WidgetGuide_Click" />
              </WrapPanel>
            </StackPanel>
          </Border>
          <TextBlock Style="{StaticResource SectionTitle}" Text="{s:Tr Es='Instalados', En='Installed'}" />
          <StackPanel x:Name="WidgetsList" />
        </StackPanel>

        <!-- ═════════════ Acerca de ═════════════ -->
        <StackPanel x:Name="AboutSection" Margin="0,18,0,0">
          <Border CornerRadius="12" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Padding="22">
            <StackPanel Orientation="Horizontal">
              <Image Source="pack://application:,,,/Assets/logo.png" Width="80" Height="80" RenderOptions.BitmapScalingMode="HighQuality" />
              <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Zenit" FontSize="22" FontWeight="SemiBold" Foreground="White" />
                <TextBlock x:Name="AboutVersion" FontSize="13" Foreground="{StaticResource Muted}" />
                <TextBlock FontSize="13" Margin="0,2,0,0">
                  <Run Text="{s:Tr Es='Desarrollado por', En='Developed by'}" Foreground="{StaticResource Muted}" />
                  <Hyperlink NavigateUri="https://danidev.cl" RequestNavigate="Developer_RequestNavigate" Foreground="#7DD3FC" TextDecorations="None">
                    <Run Text="Danidev.cl" FontWeight="SemiBold" />
                  </Hyperlink>
                </TextBlock>
                <TextBlock FontSize="13" Foreground="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"
                           Text="{s:Tr Es='La isla dinámica para Windows. Código abierto con licencia MIT.', En='The dynamic island for Windows. Open source, MIT licensed.'}" />
                <TextBlock FontSize="11.5" Foreground="{StaticResource Subtle}" Margin="0,6,0,0" TextWrapping="Wrap"
                           Text="{s:Tr Es='Proyecto independiente, sin relación con Apple, Spotify, TIDAL ni Google. iPhone y Dynamic Island son marcas de Apple Inc.; Spotify, de Spotify AB; TIDAL, de TIDAL Music AS; YouTube Music, de Google LLC.', En='Independent project, not affiliated with Apple, Spotify, TIDAL or Google. iPhone and Dynamic Island are trademarks of Apple Inc.; Spotify of Spotify AB; TIDAL of TIDAL Music AS; YouTube Music of Google LLC.'}" />
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                  <Border CornerRadius="11" Background="#2934D399" BorderBrush="#6634D399" BorderThickness="1" Padding="10,3" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" Foreground="#34D399" VerticalAlignment="Center" Margin="0,1,6,0" />
                      <TextBlock Text="{s:Tr Es='Licencia MIT', En='MIT License'}" FontSize="12" FontWeight="SemiBold" Foreground="#A7F3D0" />
                    </StackPanel>
                  </Border>
                  <Button Content="{s:Tr Es='Ver licencia', En='View license'}" Padding="14,5" Margin="10,0,0,0" Click="License_Click" />
                  <Button Content="{s:Tr Es='Código fuente', En='Source code'}" Padding="14,5" Margin="8,0,0,0" Click="Source_Click" />
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Border>

          <TextBlock Style="{StaticResource SectionTitle}" Text="{s:Tr Es='Actualizaciones', En='Updates'}" />
          <Border CornerRadius="8" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Padding="16,13" Margin="0,0,0,4">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="&#xE895;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" VerticalAlignment="Center" Margin="2,0,18,0" Foreground="#E6FFFFFF" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                <TextBlock x:Name="UpdateTitle" FontSize="14" Foreground="White" TextWrapping="Wrap" />
                <TextBlock x:Name="UpdateDetail" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0" />
                <ProgressBar x:Name="UpdateProgress" Height="4" Margin="0,8,0,0" Maximum="1" Visibility="Collapsed" />
              </StackPanel>
              <Button x:Name="UpdateButton" Grid.Column="2" Padding="16,6" Click="Update_Click" />
            </Grid>
          </Border>
          <c:SettingCard Glyph="&#xE823;" Header="{s:Tr Es='Buscar actualizaciones automáticamente', En='Check for updates automatically'}"
                         Description="{s:Tr Es='Antes de instalar se verifica el SHA-256 publicado en la versión', En='The SHA-256 published with the release is verified before installing'}">
            <CheckBox x:Name="AutoUpdateSwitch" Style="{StaticResource Switch}" Click="Any_Changed" />
          </c:SettingCard>

          <TextBlock Style="{StaticResource SectionTitle}" Text="{s:Tr Es='Privacidad', En='Privacy'}" />
          <Border CornerRadius="8" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Padding="18,14">
            <StackPanel>
              <TextBlock Foreground="White" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,6"
                         Text="{s:Tr Es='• Sin cuentas, sin claves y sin telemetría.', En='• No accounts, no keys, no telemetry.'}" />
              <TextBlock Foreground="White" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,6"
                         Text="{s:Tr Es='• La música se lee localmente desde Windows. Solo con la página Letras activa se envían título y artista a LRCLIB.', En='• Music info is read locally from Windows. Only with the Lyrics page on, title and artist are sent to LRCLIB.'}" />
              <TextBlock Foreground="White" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,6"
                         Text="{s:Tr Es='• Clima: Open-Meteo · Ubicación: Windows, BigDataCloud o ipapi.co · Monedas: currency-api · UF y UTM: findic.cl o mindicador.cl · Letras: LRCLIB · Actualizaciones: GitHub.', En='• Weather: Open-Meteo · Location: Windows, BigDataCloud or ipapi.co · Currencies: currency-api · UF and UTM: findic.cl or mindicador.cl · Lyrics: LRCLIB · Updates: GitHub.'}" />
              <TextBlock Foreground="White" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,6"
                         Text="{s:Tr Es='• Todas las conexiones son HTTPS. Solo se envían coordenadas aproximadas o el nombre de una ciudad.', En='• All connections use HTTPS. Only approximate coordinates or a city name are sent.'}" />
            </StackPanel>
          </Border>

          <TextBlock Style="{StaticResource SectionTitle}" Text="{s:Tr Es='Mantenimiento', En='Maintenance'}" />
          <c:SettingCard Glyph="&#xE838;" Header="{s:Tr Es='Carpeta de configuración', En='Settings folder'}"
                         Description="{s:Tr Es='Ajustes y registro de errores', En='Settings and error log'}">
            <Button Content="{s:Tr Es='Abrir', En='Open'}" Padding="18,6" Click="OpenFolder_Click" />
          </c:SettingCard>
          <c:SettingCard Glyph="&#xE777;" Header="{s:Tr Es='Restablecer ajustes', En='Reset settings'}"
                         Description="{s:Tr Es='Vuelve todo a los valores de fábrica', En='Restore all factory defaults'}">
            <Button Content="{s:Tr Es='Restablecer', En='Reset'}" Padding="18,6" Click="Reset_Click" />
          </c:SettingCard>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
